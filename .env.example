# Copie para .env. Nunca envie credenciais pelo chat ou para o Git.
NODE_ENV=development
PORT=3015
HOST=127.0.0.1
APP_URL=http://localhost:3015
# Local usa PostgreSQL embutido em .local/postgres; produção exige DATABASE_URL.
DATABASE_URL=
DATABASE_SSL=false
LOCAL_DATA_DIR=.local/postgres
# local: nenhuma cobrança ou gravação no Google. live: integrações reais.
INTEGRATION_MODE=local
SALES_ENABLED=false
# Só habilitar depois de inspecionar Apps Script/planilha e resolver reservas antigas.
LEGACY_REVIEW_COMPLETE=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SELLER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=1wQVEsOTbFgtBpOJD6-rbgrbep3A28oYd7VYQxDhaMAU
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TEAM_EMAILS=
# Opcional: certificado CA do PostgreSQL em PEM; não desative a validação TLS.
DATABASE_CA=
